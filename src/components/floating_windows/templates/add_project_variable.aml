align [alignment: "center"]
  vstack [width: 62]
    container [height: 1, background: state.app_theme.overlay_heading, foreground: state.app_theme.overlay_foreground, max_width: 62]
      expand
        hstack
          text [bold: true] "  Add Project Variable"

    zstack
      border [
        background: state.app_theme.overlay_background,
        foreground: state.app_theme.border_focused,
        border_style: "╭─╮│╯─╰│",
        sides: ["left", "right", "bottom"],
        min_width: attributes.minwidth,
        max_width: 80,
        fill: " "
      ]

        padding [padding: 1]
          vstack [background: state.app_theme.overlay_background]
            @add_project_variable_name (
              text_change -> add_project_variable_name_update,
              escape -> add_project_variable_name_escape
            ) [id: "add_project_variable_name", label: "(V)ariable Name"]

            @add_project_variable_public_value (
              text_change -> add_project_variable_public_value_update,
              escape -> add_project_variable_public_value_escape
            ) [id: "add_project_variable_public_value", label: "P(u)blic Value"]

            @add_project_variable_private_value (
              text_change -> add_project_variable_private_value_update,
              escape -> add_project_variable_private_value_escape
            ) [id: "add_project_variable_private_value", label: "(P)rivate Value"]

            //text state.variable.name

      container [height: 12]
        vstack
          spacer
          hstack [width: 60]
            spacer
            text [min_height: 1] ""
              span [foreground: state.border_color] "─"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_submit_background] "█"
              span [background: state.app_theme.overlay_submit_background, foreground: state.app_theme.overlay_submit_foreground] "(S)ubmit"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_submit_background] "█"
            text [min_height: 1] ""
              span [foreground: state.border_color] "─"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_cancel_background] "█"
              span [background: state.app_theme.overlay_cancel_background, foreground: state.app_theme.overlay_cancel_foreground] "(C)ancel"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_cancel_background] "█"
