align [alignment: "center"]
  zstack [background: state.app_theme.overlay_background, fill: " "]
    vstack [width: 62]
      container [height: 1, background: state.app_theme.overlay_heading, foreground: state.app_theme.overlay_foreground]
        expand
          hstack
            text [bold: true] " Change Endpoint Name: "

      border [sides: ["left", "right", "bottom"], foreground: state.app_theme.border_focused, border_style: "╭─╮│╯─╰│", width: 62]
        vstack
          padding [padding: 1]
            @edit_endpoint_name_input (
              text_change -> name_input_update,
              escape -> name_input_escape,
              edit_input__enter -> name_input_enter,
            ) [id: "endpoint_name_input", label: "(E)ndpoint Name"]

    vstack [height: 5, width: 62]
      spacer
      padding [left: 3]
        text [id: "endpoint_name_errors"] "─"
          span [foreground:  state.app_theme.menu_color_3] state.unique_name_error

    container [height: 7, width: 62]
      vstack
        spacer
        hstack [width: 60]
          spacer
          container [id: "submit_button"]
            text [min_height: 1] ""
              span [foreground: state.border_color] "─"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.success_button_color] state.button_cap_left
              span [background: state.success_button_color, foreground: state.app_theme.overlay_submit_foreground] "(S)ubmit"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.success_button_color] state.button_cap_right
          container [id: "cancel_button"]
            text [min_height: 1] ""
              span [foreground: state.border_color] "─"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.cancel_button_color] state.button_cap_left
              span [background: state.cancel_button_color, foreground: state.app_theme.overlay_cancel_foreground] "(C)ancel"
              span [bold: true, background: state.app_theme.overlay_background, foreground: state.cancel_button_color] button_cap_right
