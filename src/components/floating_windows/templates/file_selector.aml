align [alignment: "center"]
  zstack [fill: " "]
    vstack [width: 80]
      container [height: 1, background: state.app_theme.overlay_heading, foreground: state.app_theme.overlay_foreground]
        expand
          hstack
            text [bold: true] " Directory: " state.current_directory
      border [sides: ["left", "bottom", "right"], background: state.app_theme.overlay_background, foreground: state.app_theme.border_focused, border_style: "╭─╮│╯─╰│", min_width: attributes.minwidth, max_width: 80]
        padding [padding: 1]
          vstack [min_height: 3]
            container [min_height: 5]
              vstack [width: 80]
                for directory in state.window_list
                  container [fill: " ", width: 79, foreground: directory.row_fg_color, background: directory.row_color]
                    text directory.name
