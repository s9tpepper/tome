align [alignment: "center"]
  zstack [fill: " "]
    vstack [width: 25]
      container [height: 1, background: state.app_theme.overlay_heading, foreground: state.app_theme.overlay_foreground]
        expand
          hstack
            text [bold: true] " Button Style"
      border [sides: ["left", "bottom", "right"], background: state.app_theme.overlay_background, foreground: state.app_theme.border_focused, border_style: "╭─╮│╯─╰│", min_width: attributes.minwidth, max_width: 25]
        padding [padding: 1]
          vstack [min_height: 3]

            container [min_height: 5]
              vstack
                text " "
                for button_style in state.window_list
                  vstack [width: 25, foreground: button_style.row_color]
                    text [width: 25, text_align: "center"] "    " button_style.name
                    text " "
