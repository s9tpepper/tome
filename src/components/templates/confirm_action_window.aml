align [alignment: "center"]
  container [max_width: 50, height: 7]
    zstack [foreground: state.app_theme.overlay_foreground, background: state.app_theme.overlay_background, border_style: "╭─╮│╯─╰│", min_width: minwidth, max_width: 50]
      vstack [max_width: 50]
        container [max_width: 50, height: 1, background: state.app_theme.overlay_heading, foreground: state.app_theme.overlay_background]
          expand
            hstack
              text "  " title


        border [foreground: state.app_theme.border_focused, width: 50, border_style: "╭─╮│╯─╰│", sides: ["left", "bottom", "right"]]
          padding [padding: 2]
            text message

      vstack [height: 9, width: 50]
        spacer
        container [height: 1, max_width: 48]
          hstack
            spacer
            text [min_height: 1] ""
              span [foreground: state.app_theme.border_focused] "─"
            container [id: "yes_button"]
              text [min_height: 1] ""
                span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_submit_background] "█"
                span [background: state.app_theme.overlay_submit_background, foreground: state.app_theme.overlay_submit_foreground] "(Y)es"
                span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_submit_background] "█"
            text [min_height: 1] ""
              span [foreground: state.app_theme.border_focused] "─"
            container [id: "no_button"]
              text [min_height: 1] ""
                span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_cancel_background] "█"
                span [background: state.app_theme.overlay_cancel_background, foreground: state.app_theme.overlay_cancel_foreground] "(N)o"
                span [bold: true, background: state.app_theme.overlay_background, foreground: state.app_theme.overlay_cancel_background] "█"
