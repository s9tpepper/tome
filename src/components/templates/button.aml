text [
  id: state.button_id,
  bold: false,
  background: attributes.background,
  foreground: attributes.foreground
] state.button_cap_left
  span [bold: true, foreground: attributes.background, background: attributes.foreground] attributes.button_label
  span [bold: false, foreground: attributes.background, background: attributes.foreground] attributes.button_item
  span [bold: true, background: attributes.background, foreground: attributes.foreground] state.button_cap_right
