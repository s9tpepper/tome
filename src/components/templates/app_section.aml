zstack
  border [id: state.section_id, foreground: state.app_theme.border_color, border_style: "╭─╮│╯─╰│"]
    $children

  vstack
    if attributes.show_top_label
      text "╭─" attributes.top_label ":"

    if attributes.show_bottom_label
      vstack
        spacer
        text [min_height: 1] "╰"
          for val in attributes.bottom_label
            span [foreground: state.border_color, background: state.app_theme.background] "─"
            span [bold: true, background: state.app_theme.background, foreground: state.app_theme.menu_opt_background] "█"
            span [foreground: state.app_theme.background, background: state.app_theme.menu_opt_background] val
            span [background: state.app_theme.background, foreground: state.app_theme.menu_opt_background] "█"
