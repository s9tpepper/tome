container [height: 3, max_height: 3]
  zstack
    border [foreground: border_color, border_style: "╭─╮│╯─╰│", min_width: attributes.minwidth]
      if attributes.expanding
        expand [axis: "horizontal"]
          $children
      else
        $children

    if attributes.top_label
      text "╭─" attributes.top_label  ":"
    vstack
      spacer
      text "╰─" attributes.bottom_label
