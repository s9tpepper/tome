zstack
  zstack
    border [id: state.section_id, foreground: state.active_border_color, border_style: "╭─╮│╯─╰│"]
      @request_body_input [id: "textarea"]

    vstack
      text "╭─Request (B)ody:"

  hstack [id: "body_mode_hstack", height: 1]
    spacer [id: "body_mode_spacer", width: 1]
    text " Bod(y) Mode: ["
    container [id: "body_mode_display", width: 17, height: 1, fill: " "]
      align [width: 17, alignment: "center", height: 1]
        text [text_align: "center", width: 11] attributes.endpoint.body_mode ":" attributes.endpoint.raw_type
    text "]─╮"

  vstack
    spacer
    hstack
      text [min_height: 1] "╰"
      text [foreground: state.border_color, background: state.app_theme.background] "─"
      @button (click -> send_request_click) [
        button_label: "",
        button_item: "Send (R)equest",
        foreground: state.app_theme.menu_opt_background,
        background: state.app_theme.background,
        button_id: "send_request_from_headers_button"
      ]
      text [min_height: 1] "─"
      @button (click -> show_request_headers) [
        button_label: "",
        button_item: "Show Request Hea(d)ers",
        foreground: state.app_theme.menu_opt_background,
        background: state.app_theme.background,
        button_id: "send_request_from_headers_button"
      ]
