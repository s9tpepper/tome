container [height: 1]
  zstack
    border [foreground: state.border_color, width: 58, height: 3, border_style: "╭─╮│╯─╰│"]
      zstack
        text state.input
        text state.cursor_prefix
          span [foreground: state.fg_color, background: state.bg_color] state.cursor_char
    text "╭─" attributes.label ":"
